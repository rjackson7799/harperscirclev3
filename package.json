{
  "name": "harpers-circle",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.15.0 <23",
    "npm": ">=10.9.0"
  },
  "packageManager": "npm@10.9.2",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "db:reset": "supabase db reset",
    "test:db": "supabase test db",
    "test:concurrency": "node scripts/concurrency/run.mjs",
    "db:verify": "supabase db lint --fail-on warning",
    "test:app": "vitest run",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@supabase/ssr": "0.12.4",
    "@supabase/supabase-js": "2.112.3",
    "next": "16.3.1",
    "pg": "8.16.3",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "0.0.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.62.1",
    "@types/node": "^22",
    "@types/pg": "8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "axe-core": "4.13.0",
    "eslint": "^9",
    "eslint-config-next": "16.3.1",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "jsdom": "30.0.1",
    "smol-toml": "1.8.0",
    "supabase": "2.100.1",
    "typescript": "^5",
    "vitest": "4.1.10"
  }
}
