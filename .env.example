# ============================================================================
# Harper's Circle — environment (2B). Copy to .env.local for development;
# .env* is git-ignored and the values below are the local stack's public
# demo defaults, never production secrets.
# ============================================================================

# The Supabase API (kong) — `npx supabase status` prints these.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54341
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6ImFub24iLCJleHAiOjE5ODM4MTI5OTZ9.CRXP1A7WOeoJeXxjNni43kdQwgnWNReilDMblYTn_I0

# The service-role key is read by exactly ONE module — lib/db/service-role.ts
# — and CI greps for its variable name repo-wide (single-module containment),
# so the name is deliberately not written in this file. Take the value from
# `npx supabase status` and set it in .env.local under the name that module
# documents.

# Direct database connections.
# HC_DB_URL: the maintenance identity — the request-role channel and the
#   enumerated maintenance ops (lib/db/maintenance.ts) ride it.
# HC_ADMIN_DB_URL / HC_PIPELINE_DB_URL: the asAdmin()/asPipeline() factory
#   credentials; hosted these are dedicated LOGIN credentials provisioned at
#   deploy (the roles themselves are NOLOGIN), locally the maintenance URL.
HC_DB_URL=postgresql://postgres:postgres@127.0.0.1:54342/postgres
HC_ADMIN_DB_URL=postgresql://postgres:postgres@127.0.0.1:54342/postgres
HC_PIPELINE_DB_URL=postgresql://postgres:postgres@127.0.0.1:54342/postgres

# The worker key gates /api/worker/* (the §5.11 security-action sweep).
# Unset = the worker routes answer 503 (disabled, never open).
HC_WORKER_KEY=

# The public origin invite links are built from (never the Host header).
NEXT_PUBLIC_SITE_URL=
