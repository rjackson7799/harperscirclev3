# dependencies
node_modules/

# next.js
.next/
out/
next-env.d.ts

# environment — secrets never committed
.env*.local
.env

# supabase local state
supabase/.branches
supabase/.temp

# builds and coverage
build/
coverage/

# playwright output
test-results/

# vitest run record (round-18 F-7): every `npm run test:app` writes the run's
# per-case names, durations and failure messages here, so the fence transient
# arrives WITH A NAME instead of as "it went red once". Local artefact only.
.vitest/

# AGENTS.md and CLAUDE.md are TRACKED, deliberately.
#
# They were ignored here on the reading that `next dev` regenerates them. It
# does not: writeAgentFiles() upserts only the block between the
# nextjs-agent-rules markers, and returns claudeMd:'skipped' while AGENTS.md
# hosts that block (node_modules/next/dist/server/lib/generate-agent-files.js).
# AGENTS.md's own header says the same — committing it keeps the tree clean.
#
# CLAUDE.md now carries the project's standing charter, so ignoring it meant a
# fresh clone, a fresh worktree and CI all had NO project doctrine at all.
# AGENTS.md must keep hosting the marker pair, or next dev starts writing into
# CLAUDE.md instead; tests/lint/process.test.ts asserts that.

# claude code personal settings
.claude/settings.local.json

# misc
.DS_Store
*.pem
npm-debug.log*
.vercel
*.tsbuildinfo

# 5B B9: eval run manifests. They are written by the SOLE real-key path and
# they are the artifact an owner allowlists BY DIGEST at the G9 sign-off, so
# the signed one is committed deliberately (with its ADR) rather than swept in
# by a wildcard. Nothing here is secret; what matters is that it is chosen.
eval/runs/

# preflight/gate local state (last-seen HEAD, preserved run archives). The
# stack lease is host-scoped and lives in the OS temp dir, not under a tree.
.gate/
